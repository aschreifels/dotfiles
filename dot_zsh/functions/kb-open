# kb-open — list & read open work in the necro-kb knowledge base
#
# Scans the KB for articles whose frontmatter says `status: active` (the
# convention for initiative/handoff briefs and in-flight research). The
# frontmatter is the work queue; wrap sessions flip briefs to
# `status: completed`, which drops them from this list.
#
# Built on the Charm stack per CONVENTIONS.md → Tooling: yq for frontmatter,
# gum for interaction, glow for reading.
#
# Usage:
#   kb-open                  # list everything open
#   kb-open curri            # narrow by pattern (case-insensitive, content-wide)
#   kb-open -i               # fuzzy-pick a brief and read it in glow
#   kb-open -p               # paths only (pipeable: kb-open -p | xargs bat)
#
# Environment:
#   NECRO_KB    KB root (default: ~/projects/necro-kb — home-agnostic on purpose)

local kb="${NECRO_KB:-$HOME/projects/necro-kb}"
local filter=""
local paths_only=false
local interactive=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--paths)       paths_only=true;  shift ;;
    -i|--interactive) interactive=true; shift ;;
    -h|--help)
      echo "kb-open — list & read open work (status: active) in the necro-kb"
      echo ""
      echo "Usage:"
      echo "  kb-open              list everything open"
      echo "  kb-open <pattern>    narrow by pattern (case-insensitive)"
      echo "  kb-open -i           fuzzy-pick a brief and read it in glow"
      echo "  kb-open -p           paths only (pipeable)"
      echo ""
      echo "Environment:"
      echo "  NECRO_KB             KB root (default: ~/projects/necro-kb)"
      return 0
      ;;
    -*)
      echo "kb-open: unknown option '$1' (use --help)" >&2
      return 1
      ;;
    *)
      filter="${filter:+$filter }$1"
      shift
      ;;
  esac
done

if [[ ! -d "$kb" ]]; then
  echo "kb-open: KB not found at ${kb} (set NECRO_KB to override)" >&2
  return 1
fi

local dep
for dep in rg yq; do
  if ! command -v "$dep" >/dev/null; then
    echo "kb-open: ${dep} is required (brew install ${dep})" >&2
    return 1
  fi
done

# ── Collect active articles ──────────────────────────────────────
local -a files
files=(${(f)"$(command rg -l --sort path '^status:[[:space:]]*active' "$kb" \
  --glob '*.md' --glob '!output/**' --glob '!raw/**' 2>/dev/null)"})

# ── Optional narrowing filter ────────────────────────────────────
if [[ -n "$filter" && ${#files} -gt 0 ]]; then
  files=(${(f)"$(command rg -li "$filter" "${files[@]}" 2>/dev/null)"})
fi

if [[ ${#files} -eq 0 ]]; then
  if [[ -n "$filter" ]]; then
    echo "kb-open: nothing open matching '${filter}'"
  else
    echo "kb-open: nothing open — the KB work queue is clear ✓"
  fi
  return 0
fi

if $paths_only; then
  print -l -- "${files[@]}"
  return 0
fi

# ── Frontmatter helper (yq does the parsing, no awk gymnastics) ──
_kb_fm() { yq --front-matter=extract "$2 // \"\"" "$1" 2>/dev/null }

# ── Interactive: fuzzy-pick with gum, read with glow ─────────────
if $interactive; then
  for dep in gum glow; do
    if ! command -v "$dep" >/dev/null; then
      echo "kb-open: ${dep} is required for -i (brew install ${dep})" >&2
      return 1
    fi
  done

  local f choice
  local -a lines
  for f in "${files[@]}"; do
    lines+=("$(_kb_fm "$f" .title)  ·  ${f/#$HOME/~}")
  done

  choice="$(print -l -- "${lines[@]}" | gum filter \
    --placeholder 'Pick an open brief…' \
    --indicator '→' --height 12)" || { unfunction _kb_fm 2>/dev/null; return 0 }

  # NB: never name this `path` — zsh ties that variable to $PATH, and
  # assigning it clobbers command lookup for the rest of the function.
  local article="${choice##*  ·  }"
  unfunction _kb_fm 2>/dev/null
  glow -p "${article/#\~/$HOME}"
  return $?
fi

# ── Static list ──────────────────────────────────────────────────
local f title type domain updated
for f in "${files[@]}"; do
  title="$(_kb_fm "$f" .title)"
  type="$(_kb_fm "$f" .type)"
  domain="$(_kb_fm "$f" .domain)"
  updated="$(_kb_fm "$f" .updated)"
  print -P "%B%F{cyan}${type:-?}%f%b  ${title:-${${f:t}%.md}}  %F{8}(${domain:-?}, updated ${updated:-?})%f"
  print -P "      %F{8}${f/#$HOME/~}%f"
done

unfunction _kb_fm 2>/dev/null

print -P "\n%F{8}${#files} open · kb-open -i to read one · wrap-session flips status to clear.%f"
