{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(bun install)",
      "Bash(bunx tsc:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git rebase*)",
      "Bash(git pull --rebase*)",
      "Bash(git reset --hard*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.config/ai",
      "{{ .chezmoi.homeDir }}/dossiers",
      "{{ .chezmoi.homeDir }}/dossiers-archive",
      "{{ .chezmoi.homeDir }}/projects/necro-kb"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/kb-pulse.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "tui": "fullscreen"
}
