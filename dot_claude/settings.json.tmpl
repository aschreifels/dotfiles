{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/projects/necro-kb",
      "{{ .chezmoi.homeDir }}/.config/ai"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git rebase*)",
      "Bash(git pull --rebase*)",
      "Bash(git reset --hard*)"
    ]
  }
}
